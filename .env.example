# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database (SQLite)
DATABASE_URL=sqlite:storage/reader.db?mode=rwc

# Storage paths
STORAGE_DIR=storage
ASSETS_DIR=storage/assets

# Web frontend path (adjust if needed)
WEB_ROOT=frontend/dist

# Logging
LOG_LEVEL=info

# Request timeout in seconds
REQUEST_TIMEOUT_SECS=15

# Security settings
SECURE=true
SECURE_KEY=

# User registration
INVITE_CODE=
USER_LIMIT=50
USER_BOOK_LIMIT=2000
# 0 means unlimited
USER_LOCAL_BOOK_LIMIT=0

# WebView / Dynamic Rendering Configuration
# 1. Cloudflare Kitesurf (Primary / Free headless browser on Workers)
# In Workers environment, set these as Secrets:
#   npx wrangler secret put CF_ACCOUNT_ID
#   npx wrangler secret put CF_API_TOKEN
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_KITESURF_ENDPOINT=
CF_KITESURF_ENABLED=true

# 2. Remote WebView API (Secondary / Fallback when Kitesurf hits 429 cooldown or is unavailable)
REMOTE_WEBVIEW_API=
REMOTE_WEBVIEW_API_KEY=

# R2 Bucket Name (Object Storage)
R2_BUCKET_NAME=reader-storage
